# ---- Server security (public hosting par ZARURI) ----
# Login password — set karoge to app password maangega
APP_PASSWORD=change-me-strong-password
# Session signing key — stable rakho (restart pe logout na ho)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Finder keys — jo service use nahi kar rahe, khali chhod do ----
# (UI sidebar se bhi daal sakte ho; DB mein save ho jaati hain)
REOON_API_KEY=
HUNTER_API_KEY=
PROSPEO_API_KEY=
APOLLO_API_KEY=

# Monthly limits (apne dashboard se asli credits dekh kar daalo)
HUNTER_LIMIT=50
PROSPEO_LIMIT=75
APOLLO_LIMIT=50

# Reset day of month (1-28)
HUNTER_RESET_DAY=1
PROSPEO_RESET_DAY=1
APOLLO_RESET_DAY=1

# ---- Features ----
# "1" = providers se pehle free pattern-guess + Reoon verify (credits bachata hai)
PATTERN_GUESS=1
# "1" = har naya valid lead webhook par auto-push
PUSH_VALID=0
# Zapier/Make/Slack/Discord webhook URL (Sheets/HubSpot Zapier ke through connect karo)
WEBHOOK_URL=

# ---- Performance ----
# Batch mein kitne leads parallel process hon
PARALLEL_LEADS=3
# Per-provider minimum request interval (seconds) — rate limit se bachao
PROVIDER_MIN_INTERVAL=0.5

# ---- Backups ----
BACKUP_HOURS=24
BACKUP_KEEP=7

# ---- Outreach (Instantly / Smartlead) ----
OUTREACH_PROVIDER=instantly
OUTREACH_API_KEY=
OUTREACH_CAMPAIGN=

# ---- Google Sheets writeback (scheduled runs) ----
# Service-account JSON string ya file path; sheet ko uske email se share karo
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Reverse proxy (Caddy/nginx ke peeche "1" karo) ----
TRUST_PROXY=0
# Caddy HTTPS profile ke liye apna domain (DNS A record -> server IP)
DOMAIN=localhost

# ---- Storage ----
# Docker/Railway volume folder (container mein /data mount karo)
DATA_DIR=/data
# Ya direct SQLite file path:
# DB_PATH=/data/leads.db